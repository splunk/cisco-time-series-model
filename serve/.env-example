# ──────────────────────────────────────────────────────────────
# CDTSM Inference Server – Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the required values:
#   cp .env-example .env
#
# .env is git-ignored and will NOT be committed.
# ──────────────────────────────────────────────────────────────

# [REQUIRED] Bearer token for API authentication.
# Callers must send: Authorization: Bearer <token>
CDTSM_AUTH_TOKEN=

# ──────────── TLS / Corporate Proxy ────────────

# If running in Docker behind a corporate TLS-inspecting proxy,
# the proxy's CA certificate is not in the container's trust store.
# Uncomment to disable TLS verification for Hugging Face downloads:
# CDTSM_HF_INSECURE_SSL=true

# Alternatively, mount your corporate CA bundle and point to it:
# CDTSM_HF_SSL_CA_BUNDLE=/path/to/corporate-ca-bundle.pem

# ──────────── Model & Runtime ────────────

# Hugging Face model repository
# CDTSM_HF_REPO_ID=cisco-ai/cisco-time-series-model-1.0

# PyTorch backend: cpu | gpu | auto
# CDTSM_TORCH_BACKEND=cpu

# ──────────── Server ────────────

# Bind address and port
# CDTSM_HOST=0.0.0.0
# CDTSM_PORT=8080

# Log level: DEBUG | INFO | WARNING | ERROR
# CDTSM_LOG_LEVEL=INFO
